# .env.example — copy to .env and fill real values. DO NOT commit .env.
HOST=0.0.0.0
PORT=1337

# Generate each secret with: openssl rand -base64 32
APP_KEYS=key1,key2
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=

# Database (SQLite)
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

